# Phase 1.5 controlled real API beta feature flags.
# Default off keeps the app fully functional with local/mock fallbacks.
ENABLE_LIVE_SEARCH=false
ENABLE_LLM_ANALYSIS=false
ENABLE_EMAIL_REPORT=false
ENABLE_BACKEND_LOGGING=false
ENABLE_CRM_SYNC=false
CRM_PROVIDER=salesforce

# Phase 1.5 usage limits.
DAILY_SEARCH_LIMIT=25
DAILY_LLM_LIMIT=50
DAILY_EMAIL_LIMIT=10
PER_SESSION_LLM_LIMIT=12
PER_SESSION_SEARCH_LIMIT=8
PER_SESSION_EMAIL_LIMIT=3
SEARCH_CACHE_TTL_HOURS=24

# Optional server-side provider credentials.
# Never expose these in frontend code and never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
SEARCH_API_KEY=
SEARCH_API_URL=
RESEND_API_KEY=
REPORT_EMAIL_FROM=
REPORT_EMAIL_REPLY_TO=
APP_BASE_URL=
DATABASE_URL=

# Optional CRM sync for explicit marketing/update consent only.
# Salesforce credentials must stay server-side in Vercel/local env vars.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=60.0
