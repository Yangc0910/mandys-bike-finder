# Copy this file to .env and adjust paths if needed.

# Google OAuth client secret JSON downloaded from Google Cloud Console.
GMAIL_CLIENT_SECRET_FILE=credentials/client_secret.json

# Local OAuth token cache. This is created automatically after first consent.
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# Optional: override the config path used by `listing-monitor run`.
CONFIG_PATH=config.yaml

# Web MVP server.
PORT=5173

# Phase 1.5 controlled real API beta feature flags.
# Default off keeps the app fully functional with local/mock fallbacks.
ENABLE_LIVE_SEARCH=false
ENABLE_LLM_ANALYSIS=false
ENABLE_EMAIL_REPORT=false
ENABLE_BACKEND_LOGGING=false

# Phase 1.5 usage limits.
DAILY_SEARCH_LIMIT=25
DAILY_LLM_LIMIT=50
DAILY_EMAIL_LIMIT=10
SEARCH_CACHE_TTL_HOURS=24

# Optional server-side provider credentials.
# Never expose these in frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SEARCH_API_KEY=
SEARCH_API_URL=
EMAIL_API_KEY=
EMAIL_API_URL=
EMAIL_FROM=
DATABASE_URL=
