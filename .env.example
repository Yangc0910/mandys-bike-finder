# Copy this file to `.env.local` for `/app` local development (or `.env` for legacy tools).
# Never commit real secrets.

# Legacy Python prototype email settings (not required for Next.js `/app` flow).
# Google OAuth client secret JSON downloaded from Google Cloud Console.
GMAIL_CLIENT_SECRET_FILE=credentials/client_secret.json

# Local OAuth token cache. This is created automatically after first consent.
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# Optional: override the config path used by `listing-monitor run`.
CONFIG_PATH=config.yaml

# Legacy `web/` MVP server.
PORT=5173

# Next.js `/app` feature flags (server-side).
# Default off keeps the app fully functional with local/mock fallbacks.
ENABLE_LIVE_SEARCH=false
ENABLE_LLM_ANALYSIS=false
ENABLE_EMAIL_REPORT=false
ENABLE_BACKEND_LOGGING=false
ENABLE_CRM_SYNC=false
CRM_PROVIDER=salesforce
SALESFORCE_AUTH_MODE=web_to_lead

# API usage/cost controls.
DAILY_SEARCH_LIMIT=25
DAILY_LLM_LIMIT=10
DAILY_EMAIL_LIMIT=10
PER_SESSION_LLM_LIMIT=10
GUIDED_ASSISTANT_DAILY_LIMIT=50
GUIDED_ASSISTANT_PER_SESSION_LIMIT=10
PER_SESSION_SEARCH_LIMIT=8
PER_SESSION_EMAIL_LIMIT=3
SEARCH_CACHE_TTL_HOURS=24

# Server-side provider credentials.
# Never expose these in frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
SEARCH_API_KEY=
SEARCH_API_URL=
RESEND_API_KEY=
REPORT_EMAIL_FROM=
REPORT_EMAIL_REPLY_TO=
APP_BASE_URL=
DATABASE_URL=

# Optional CRM sync for explicit marketing/update consent only.
# Salesforce credentials must stay server-side in Vercel/local env vars.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=60.0
SALESFORCE_WEB_TO_LEAD_OID=
SALESFORCE_WEB_TO_LEAD_URL=https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8
